    {
      "parameters": {
        "jsCode": "// รับข้อความผลลัพธ์จากหลายรูปแบบของโหนด AI\nlet text =\n  $json?.candidates?.[0]?.content?.parts?.[0]?.text ??\n  $json?.output ??              // AI Agent ของ n8n ชอบใส่ไว้ตรงนี้\n  $json?.text ??\n  '';\n\nif (typeof text !== 'string') text = JSON.stringify(text);\ntext = text.trim();\n\n// ลอก code fences / คำว่า \"json\" ที่ชอบติดมาหน้า-หลัง\ntext = text\n  .replace(/^```(?:json)?\\s*/i, '')\n  .replace(/```$/,'')\n  .replace(/^json\\s*/i, '');\n\n// พยายาม parse ให้สุดทาง\nlet obj;\ntry {\n  obj = JSON.parse(text);\n} catch {\n  // ตัดเฉพาะช่วง { ... } ที่ยาวสุด\n  const start = text.indexOf('{');\n  const end   = text.lastIndexOf('}');\n  if (start !== -1 && end > start) {\n    const slice = text.slice(start, end + 1);\n    try { obj = JSON.parse(slice); } catch {}\n  }\n  // แก้เคสมี comma เกิน\n  if (!obj) {\n    const fixed = text.replace(/,\\s*([}\\]])/g, '$1');\n    try { obj = JSON.parse(fixed); } catch {}\n  }\n}\n\n// บังคับให้ข้อมูลพร้อมใช้งาน\nconst threshold = Number($node[\"Prepare Text from PDF\"].json.threshold || 70);\n\nif (obj && typeof obj.score_percent === 'string') {\n  const n = Number(obj.score_percent);\n  if (!Number.isNaN(n)) obj.score_percent = n;\n}\n\nif (!obj || typeof obj.score_percent !== 'number') {\n  return [{ score_percent: 0, verdict: \"fail\", reasons: [\"Invalid JSON from Gemini\"], raw: text }];\n}\n\nif (!obj.verdict) {\n  obj.verdict = obj.score_percent >= threshold ? \"pass\" : \"fail\";\n}\nif (!Array.isArray(obj.reasons)) {\n  obj.reasons = [String(obj.reasons ?? \"No reasons provided\")];\n}\n\nreturn [obj];\n"
      },
